<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.tij-code</groupId>
        <artifactId>registermaschine</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <groupId>io.github.tij-code.registermaschine</groupId>
    <artifactId>core</artifactId>
    <packaging>jar</packaging>
    <name>Registermaschine Core Runtime</name>
    <description>Java library that can run and compile customised instructions</description>
    <url>https://github.com/TiJ-code/Registermaschine</url>

    <scm>
        <connection>scm:git:https://github.com/TiJ-code/Registermaschine.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/TiJ-code/Registermaschine.git</developerConnection>
        <url>https://github.com/TiJ-code/Registermaschine</url>
    </scm>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>tij</id>
            <name>TiJ</name>
            <email>no@mail.org</email>
        </developer>
    </developers>

    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.tij-code.registermaschine</groupId>
            <artifactId>api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tij-code.registermaschine</groupId>
            <artifactId>compiler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tij-code.registermaschine</groupId>
            <artifactId>engine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tij-code.registermaschine</groupId>
            <artifactId>plugin-loader</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.9.0</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                            <updatePomFile>true</updatePomFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten-pom</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

